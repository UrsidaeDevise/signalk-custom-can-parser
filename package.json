{
  "name": "signalk-custom-can-parser",
  "version": "0.6.6",
  "description": "Plugin for signalk to read non NMEA2000 traffic on CAN bus.",
  "main": "index.js",
  "author": "Björn Magnusson Westin",
  "keywords": [
    "signalk-custom-can-parser",
    "signalk-category-hardware",
    "signalk-node-server-plugin"
  ],
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "Custom CAN-bus parser",
    "appIcon": "./docs/icon-128.png",
    "screenshots": [
      "./docs/screenshots/config.jpeg"
    ],
    "requires": [
      ""
    ],
    "recommends": [
      "@signalk/calibration",
      "signalk-path-mapper"
    ]
  },
  "license": "Apache-2.0",
  "dependencies": {
    "socketcan": "^4.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UrsidaeDevise/signalk-custom-can-parser.git"
  },
  "os": [
    "linux"
  ],
  "devDependencies": {
    "node-gyp": "^13.1.0"
  },
  "allowScripts": {
    "socketcan@4.3.2": true
  }
}
